// Prebuilt JNI shared libraries for SemcCameraUI

cc_prebuilt_library_shared {
    name: "libarcsoft_handsigns_semccamera",
    // stem 修正安裝檔名：不設定的話 Soong 會用 module name
    // (libarcsoft_handsigns_semccamera.so) 而不是 Java 端
    // System.loadLibrary() 實際要找的 libarcsoft_handsigns.so，
    // 會造成 dlopen 找不到檔案。
    stem: "libarcsoft_handsigns",
    srcs: ["app/src/main/jniLibs/arm64-v8a/libarcsoft_handsigns.so"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "libhandsigns_jni_semccamera",
    stem: "libhandsigns_jni",
    srcs: ["app/src/main/jniLibs/arm64-v8a/libhandsigns_jni.so"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
    prefer: true,
}

